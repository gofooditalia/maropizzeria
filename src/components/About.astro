---
import { Flame, Drumstick, ShoppingBag } from "lucide-astro";
import { site } from "../data/site";

const facts = [
  { icon: Flame, title: "Pizza dal forno", text: "Impasto a lunga lievitazione, cotto nel forno a legna." },
  { icon: Drumstick, title: "Pollo allo spiedo", text: "Cottura lenta: dorato e croccante fuori, morbido dentro." },
  { icon: ShoppingBag, title: "Al tavolo o da asporto", text: "Aperti tutti i giorni, solo a cena." },
];
---

<section id="storia" class="relative min-h-svh flex items-center py-20 lg:py-28 px-6 bg-brown-dark text-white overflow-hidden">
  <video
    class="absolute inset-0 size-full object-cover"
    muted
    playsinline
    loop
    autoplay
    aria-hidden="true"
  >
    <source src="/video/maro_video_chisiamo_mobile.mp4" media="(max-width: 767px)" />
    <source src="/video/maro_video_chisiamo.mp4" />
  </video>
  <div class="absolute inset-0 bg-brown-dark/80"></div>

  <div class="relative z-10 max-w-[1200px] mx-auto grid lg:grid-cols-2 gap-12 items-center">
    <div>
      <p class="text-accent uppercase tracking-[0.3em] text-xs font-semibold mb-3">Chi siamo</p>
      <h2 class="text-4xl lg:text-5xl font-bold leading-tight">Pizza e pollo, fatti con il cuore</h2>
      <p class="mt-6 text-lg text-white/75 leading-relaxed">
        <!-- TODO: verificare/perfezionare con il racconto reale del nuovo gestore -->
        In via Romagna nasce {site.shortName}: una nuova gestione, un locale rinnovato da cima a fondo e la stessa idea di sempre, fare le cose per bene. La pizza esce da un impasto a lunga lievitazione e da un forno a legna sempre acceso; il pollo gira lento sullo spiedo fino a diventare dorato e croccante fuori, tenero dentro.
      </p>
      <p class="mt-4 text-lg text-white/75 leading-relaxed">
        Un menu semplice da gustare al tavolo o portare a casa: aperti tutti i giorni, solo a cena.
      </p>
    </div>

    <!-- TODO: quando disponibili, sostituire con una foto del locale (public/images/about.jpg) -->
    <ul class="grid gap-4">
      {facts.map((f) => (
        <li class="flex items-start gap-5 rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
          <span class="size-12 shrink-0 rounded-xl bg-primary/20 text-accent flex items-center justify-center">
            <f.icon class="size-6" />
          </span>
          <div>
            <h3 class="text-xl font-bold">{f.title}</h3>
            <p class="text-white/70 mt-1">{f.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
