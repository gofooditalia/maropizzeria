---
import { site, offer } from "../data/site";
---

<section id="pizza-pollo" class="py-20 lg:py-28 px-6 bg-cream">
  <div class="max-w-[1200px] mx-auto">
    <div class="text-center max-w-2xl mx-auto">
      <p class="text-primary uppercase tracking-[0.3em] text-xs font-semibold mb-3">Pizza & Pollo</p>
      <h2 class="text-4xl lg:text-5xl font-bold text-brown">Due passioni, un solo forno</h2>
      <p class="mt-4 text-neutral-text/75 text-lg">Il menu completo sarà disponibile all'apertura.</p>
    </div>

    <ul class="mt-14 grid sm:grid-cols-2 gap-6">
      {offer.map((p) => (
        <li class="rounded-2xl border border-brown/10 bg-white p-8 hover:border-primary/40 hover:shadow-lg transition-all">
          <h3 class="text-3xl font-bold text-brown">{p.name}</h3>
          <p class="mt-3 text-neutral-text/75 text-lg leading-relaxed">{p.description}</p>
        </li>
      ))}
    </ul>

    {site.menuUrl && (
      <div class="text-center mt-12">
        <a href={site.menuUrl} class="inline-flex rounded-lg h-12 px-8 items-center bg-primary text-white font-black tracking-widest uppercase text-sm hover:bg-primary-dark transition-all">
          Menu completo
        </a>
      </div>
    )}
  </div>
</section>
