---
import { Flame } from "lucide-astro";
import { site } from "../data/site";

// Sequenza di fotogrammi per lo scroll-scrub (estratti da public/video/maro_video_bg.mp4, 30fps/8.63s).
const FRAME_COUNT = 259;
const framePath = (n: number) => `/frames/hero/frame-${String(n).padStart(4, "0")}.webp`;
---

<section id="home" class="hero-scrub relative bg-brown-dark" data-frame-count={FRAME_COUNT}>
  <div class="hero-scrub__pin sticky top-0 h-svh overflow-hidden flex items-end sm:items-center justify-center">
    <canvas class="hero-scrub__canvas absolute inset-0 size-full" aria-hidden="true"></canvas>
    <video
      class="hero-scrub__video absolute inset-0 size-full object-cover hidden"
      muted
      playsinline
      loop
      aria-hidden="true"
    >
      <source src="/video/maro_video_bg_mobile.mp4" media="(max-width: 767px)" />
      <source src="/video/maro_video_bg.mp4" />
    </video>
    <img
      class="hero-scrub__poster absolute inset-0 size-full object-cover"
      src={framePath(1)}
      alt=""
      aria-hidden="true"
      fetchpriority="high"
    />

    <div class="absolute inset-0 bg-gradient-to-t from-brown-dark/90 via-brown-dark/10 to-brown-dark/40"></div>

    <div class="hero-scrub__content relative z-10 text-center px-6 max-w-2xl mx-auto pb-16 sm:pb-0">
      <h1 class="sr-only">{site.name} - Palermo</h1>

      <p class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 backdrop-blur px-4 py-2 text-white text-xs sm:text-sm font-bold uppercase tracking-[0.2em] shadow-sm">
        <Flame class="size-4 text-primary" /> {site.openingNotice}
      </p>

      <p class="text-white text-lg sm:text-xl mt-6 max-w-xl mx-auto text-shadow">
        Pizza dal forno e pollo allo spiedo in via Romagna a Palermo. Aperti tutti i giorni, a pranzo e a cena.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center mt-10">
        {site.menuUrl && (
          <a href={site.menuUrl} class="rounded-lg h-12 px-8 flex items-center justify-center bg-primary text-white font-black tracking-widest uppercase text-sm hover:bg-primary-dark transition-all shadow-lg shadow-primary/30">
            Vedi menu
          </a>
        )}
        <a href="/#contatti" class:list={["rounded-lg h-12 px-8 flex items-center justify-center font-black tracking-widest uppercase text-sm transition-all", site.menuUrl ? "border border-white/40 text-white hover:border-primary hover:text-primary" : "bg-primary text-white hover:bg-primary-dark shadow-lg shadow-primary/30"]}>
          Dove siamo
        </a>
        <a href="/#pizza-pollo" class="rounded-lg h-12 px-8 flex items-center justify-center border border-white/40 text-white font-semibold text-sm hover:border-primary hover:text-primary transition-all">
          Pizza & Pollo
        </a>
      </div>
    </div>
  </div>
</section>

<noscript>
  <style>
    .hero-scrub { height: 100svh !important; }
    .hero-scrub__content { opacity: 1 !important; transform: none !important; pointer-events: auto !important; }
  </style>
</noscript>

<script is:inline>
  // Bloccante (non-module): gira PRIMA del primo paint, quindi decide subito se questa è
  // una sessione desktop scroll-scrub (contenuto nascosto via CSS di default, vedi sotto)
  // o una sessione fallback (mobile / riduci animazioni: va rivelato subito, senza attese).
  // Evita qualsiasi lampeggio di testo/pulsanti, a differenza di uno script module deferred.
  (function () {
    var section = document.querySelector(".hero-scrub");
    if (!section) return;
    var frameCount = Number(section.dataset.frameCount || 0);
    var prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var isMobile = window.innerWidth < 768;
    if (prefersReducedMotion || isMobile || !frameCount) {
      section.classList.add("is-content-visible");
    } else {
      section.classList.add("is-scrub-active");
    }
  })();
</script>

<style>
  /* Nascosto di default: si assume la modalità scroll-scrub (il caso desktop più comune).
     Lo script inline sopra aggiunge is-content-visible PRIMA del primo paint per i casi
     fallback (mobile / riduci animazioni), quindi qui non c'è mai un lampeggio visibile. */
  .hero-scrub {
    height: 100svh;
  }

  .hero-scrub__content {
    opacity: 0;
    transform: translateY(24px);
    pointer-events: none;
  }

  .hero-scrub__content.is-visible {
    pointer-events: auto;
  }

  .hero-scrub__canvas {
    display: none;
  }

  /* Modalità desktop: canvas scroll-scrub. */
  .hero-scrub.is-scrub-active {
    height: 300vh;
  }

  .hero-scrub.is-frames-ready .hero-scrub__canvas {
    display: block;
  }

  .hero-scrub.is-frames-ready .hero-scrub__poster {
    display: none;
  }

  /* Modalità mobile / riduci animazioni: video normale in autoplay, contenuto sempre visibile. */
  .hero-scrub.is-content-visible .hero-scrub__content {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .hero-scrub.is-video-active .hero-scrub__video {
    display: block;
  }

  .hero-scrub.is-video-active .hero-scrub__poster {
    display: none;
  }

  .text-shadow {
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.45);
  }

  /* Rete di sicurezza puramente CSS: se lo script inline non parte (es. CSP che blocca
     inline script), un utente con "riduci animazioni" non resta comunque con testo nascosto. */
  @media (prefers-reduced-motion: reduce) {
    .hero-scrub:not(.is-content-visible) {
      height: 100svh;
    }
    .hero-scrub:not(.is-content-visible) .hero-scrub__content {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
  }
</style>

<script>
  function framePath(n: number) {
    return `/frames/hero/frame-${String(n).padStart(4, "0")}.webp`;
  }

  function initHeroVideoFallback(section: HTMLElement) {
    const video = section.querySelector<HTMLVideoElement>(".hero-scrub__video");
    if (!video) return;
    section.classList.add("is-video-active");
    video.play().catch(() => {});
  }

  function initHeroScrub(section: HTMLElement, frameCount: number) {
    const pin = section.querySelector<HTMLElement>(".hero-scrub__pin");
    const canvas = section.querySelector<HTMLCanvasElement>(".hero-scrub__canvas");
    const content = section.querySelector<HTMLElement>(".hero-scrub__content");
    if (!pin || !canvas || !content) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const images: HTMLImageElement[] = new Array(frameCount);
    let loadedCount = 0;
    let currentFrame = 1;
    let ticking = false;
    const revealStart = 0.7; // inizio fade-in testo/CTA (% di scroll dell'hero)
    const revealEnd = 0.85; // fade-in completato (contenuto pienamente rivelato)

    function resizeCanvas() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas!.width = window.innerWidth * dpr;
      canvas!.height = window.innerHeight * dpr;
      drawFrame(currentFrame);
    }

    function drawFrame(index: number) {
      const img = images[index - 1];
      if (!img || !img.complete || img.naturalWidth === 0) return;
      currentFrame = index;
      const canvasW = canvas!.width;
      const canvasH = canvas!.height;
      const scale = Math.max(canvasW / img.naturalWidth, canvasH / img.naturalHeight);
      const drawW = img.naturalWidth * scale;
      const drawH = img.naturalHeight * scale;
      const dx = (canvasW - drawW) / 2;
      const dy = (canvasH - drawH) / 2;
      ctx!.clearRect(0, 0, canvasW, canvasH);
      ctx!.drawImage(img, dx, dy, drawW, drawH);
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const scrollableDistance = section.offsetHeight - window.innerHeight;
        const scrolled = -section.getBoundingClientRect().top;
        const progress = scrollableDistance > 0
          ? Math.min(1, Math.max(0, scrolled / scrollableDistance))
          : 0;

        const frameIndex = Math.min(frameCount, Math.max(1, Math.round(progress * (frameCount - 1)) + 1));
        drawFrame(frameIndex);

        const reveal = Math.min(1, Math.max(0, (progress - revealStart) / (revealEnd - revealStart)));
        content!.style.opacity = String(reveal);
        content!.style.transform = `translateY(${(1 - reveal) * 24}px)`;
        content!.classList.toggle("is-visible", reveal > 0.5);

        ticking = false;
      });
    }

    // Precarica tutti i fotogrammi; attiva lo scrub solo quando sono pronti.
    for (let i = 1; i <= frameCount; i++) {
      const img = new Image();
      img.onload = () => {
        loadedCount++;
        if (i === 1) {
          resizeCanvas();
        }
        if (loadedCount === frameCount) {
          section.classList.add("is-frames-ready");
          window.addEventListener("scroll", onScroll, { passive: true });
          window.addEventListener("resize", resizeCanvas, { passive: true });
          resizeCanvas();
          onScroll();
        }
      };
      img.src = framePath(i);
      images[i - 1] = img;
    }
  }

  function init() {
    const section = document.querySelector<HTMLElement>(".hero-scrub");
    if (!section) return;

    // La modalità è già stata decisa dallo script inline (prima del primo paint):
    // qui leggiamo semplicemente quale classe ha impostato, senza rivalutare nulla.
    if (section.classList.contains("is-content-visible")) {
      initHeroVideoFallback(section);
      return;
    }

    const frameCount = Number(section.dataset.frameCount || 0);
    initHeroScrub(section, frameCount);
  }

  init();
</script>
