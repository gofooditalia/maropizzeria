---
import { Flame } from "lucide-astro";
import { site } from "../data/site";
---

<section id="home" class="relative min-h-svh flex items-center justify-center overflow-hidden bg-cream">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(198,4,4,0.08),transparent_60%)]"></div>

  <div class="relative z-10 text-center px-6 max-w-3xl mx-auto pt-28 pb-16">
    <img
      src="/images/logo.webp"
      alt={site.name}
      width="1200"
      height="831"
      class="w-full max-w-md sm:max-w-lg mx-auto h-auto"
      fetchpriority="high"
    />

    <p class="mt-8 inline-flex items-center gap-2 rounded-full border border-primary/30 bg-white px-4 py-2 text-primary text-xs sm:text-sm font-bold uppercase tracking-[0.2em] shadow-sm">
      <Flame class="size-4" /> {site.openingNotice}
    </p>

    <h1 class="sr-only">{site.name} - Palermo</h1>

    <p class="text-brown/80 text-lg sm:text-xl mt-6 max-w-xl mx-auto">
      Pizza dal forno e pollo allo spiedo in via Romagna a Palermo. Aperti tutti i giorni, a pranzo e a cena.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center mt-10">
      {site.menuUrl && (
        <a href={site.menuUrl} class="rounded-lg h-12 px-8 flex items-center justify-center bg-primary text-white font-black tracking-widest uppercase text-sm hover:bg-primary-dark transition-all shadow-lg shadow-primary/30">
          Vedi menu
        </a>
      )}
      <a href="/#contatti" class:list={["rounded-lg h-12 px-8 flex items-center justify-center font-black tracking-widest uppercase text-sm transition-all", site.menuUrl ? "border border-brown/30 text-brown hover:border-primary hover:text-primary" : "bg-primary text-white hover:bg-primary-dark shadow-lg shadow-primary/30"]}>
        Dove siamo
      </a>
      <a href="/#pizza-pollo" class="rounded-lg h-12 px-8 flex items-center justify-center border border-brown/30 text-brown font-semibold text-sm hover:border-primary hover:text-primary transition-all">
        Pizza & Pollo
      </a>
    </div>
  </div>
</section>
